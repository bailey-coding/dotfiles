# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Load zinit for fast zsh plugins
. "${HOME}/.zsh/zsh.d/zinit.zsh"

# Load fzf for fancier searching
. "${HOME}/.zsh/zsh.d/fzf.zsh"

# Potential Darwin addons
. "${HOME}/.zsh/zsh.d/darwin.zsh"

# CDPATH instead of aliases to different paths
export CDPATH="${CDPATH}:${HOME}/src2:${HOME}/src:${HOME}/work:${HOME}/src/go/src"

export PATH="/usr/local/go/bin:${HOME}/.yarn/bin:${HOME}/.config/yarn/global/node_modules/.bin:${PATH}"

export DOCKER_BUILDKIT=1
export KUSTOMIZE_ENABLE_ALPHA_COMMANDS=true

### History
setopt extended_history hist_no_store hist_ignore_dups hist_expire_dups_first hist_find_no_dups inc_append_history share_history hist_reduce_blanks hist_ignore_space
export HISTFILE=~/.zsh_history
export HISTSIZE=1000000
export SAVEHIST=1000000


### Some..  options
setopt autocd beep extendedglob nomatch rc_quotes
unsetopt notify

if type rg &> /dev/null; then
    export FZF_DEFAULT_COMMAND='rg --files --hidden'
fi

export BAT_THEME="Solarized (light)"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

export PATH="/opt/homebrew/opt/ruby/bin:/opt/homebrew/lib/ruby/gems/3.4.0/bin:/opt/homebrew/opt/sqlite/bin:${HOME}/.cargo/bin:${HOME}/.codeium/windsurf/bin:${HOME}/.mix/escripts:/usr/local/opt/ruby/bin:${HOME}/.local/bin:${PATH}"

# zoxide: smarter cd (replaces autojump/z). Use `z <query>` or `zi` for interactive.
if type zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# atuin: encrypted, syncable shell history with fuzzy search (Ctrl-R).
# Pass --disable-up-arrow to keep the standard zsh up-arrow behavior.
if type atuin &> /dev/null; then
  eval "$(atuin init zsh --disable-up-arrow)"
fi

# eza: modern ls replacement.
if type eza &> /dev/null; then
  alias ls='eza --group-directories-first'
  alias ll='eza -lh --group-directories-first --git'
  alias la='eza -lha --group-directories-first --git'
  alias lt='eza --tree --level=2 --group-directories-first'
fi

# added by Nix installer
if [ -e $HOME/.nix-profile/etc/profile.d/nix.sh ]; then
  . $HOME/.nix-profile/etc/profile.d/nix.sh;
fi
export NIX_PATH=$HOME/.nix-defexpr/channels:/nix/var/nix/profiles/per-user/root/channels${NIX_PATH:+:$NIX_PATH}

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh" || true

export PACT_DO_NOT_TRACK=1
export pact_do_not_track=1

if [ -f "${HOME}/.zshrc-extras" ]; then
  . "${HOME}/.zshrc-extras"
else
  echo "Missing zshrc-extras from private-dotfiles"
fi


# bun completions
[ -s "${HOME}/.bun/_bun" ] && source "${HOME}/.bun/_bun"

export EDITOR=vim

# pnpm
export PNPM_HOME="${HOME}/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# -F: Quit automatically if the output fits on one screen
# -X: Leave the output on the screen when less exits (doesn't clear it)
# -R: Keep ANSI colors intact
export LESS="-F -X -R"
